# Copia este archivo a ~/.config/harness/.env (fuera del repo y de iCloud) y complétalo:
#   mkdir -p ~/.config/harness && cp .env.example ~/.config/harness/.env && chmod 600 ~/.config/harness/.env
# Los scripts lo cargan solos. Otra ruta: export HARNESS_ENV_FILE=/ruta/al/.env

# --- Búsqueda remota (buscar_literatura.py) ---
ENTREZ_EMAIL=            # correo para NCBI, Unpaywall y OpenAlex (recomendado)
NCBI_API_KEY=            # opcional: sube el límite de PubMed de 3 a 10 req/s
OPENALEX_API_KEY=        # opcional: clave gratuita, sube la cuota diaria
S2_API_KEY=              # opcional: Semantic Scholar (sin clave hay más errores 429)

# --- Fuentes locales (fuentes_locales.py) ---
ZOTERO_DATA_DIR=~/Zotero # carpeta de datos de Zotero (para ubicar los PDFs adjuntos)
ZOTERO_USER_ID=          # opcional: solo si usas la API web en vez de la local
ZOTERO_API_KEY=          # opcional: idem
OBSIDIAN_VAULT=          # ruta absoluta a tu bóveda de Obsidian

# --- Proxy UC (fetch_uc_paper.py) — guárdalas con los comandos de .claude/skills/acceso-uc ---
UC_USER=
UC_PASSWORD=

# --- Exportar a PDF (opcional) ---
CHROMIUM_PATH=           # solo si no usas el Chromium que instala playwright
