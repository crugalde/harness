# .env — configuración del stack n8n. Cópialo a `.env` y complétalo EN EL VPS.
# Este archivo NO se versiona con valores reales (ver .gitignore del repo).
#
#   cp .env.example .env && chmod 600 .env

# --- Dominio y TLS -----------------------------------------------------------
# Subdominio que apunta (registro A) a la IP del VPS. Ej: n8n.tudominio.cl
N8N_DOMAIN=n8n.neuromuscular.cloud
# Correo para los avisos de Let's Encrypt (expiración/errores de certificado).
ACME_EMAIL=tu@correo.cl

# --- Versión de n8n ----------------------------------------------------------
# Pinea una versión exacta: "latest" hace que un `docker compose pull` te cambie
# de versión (incluso de major) sin avisar.
# Al 2026-08-25 los tags `latest`/`stable` apuntan a 2.36.7. La línea 2.37.x existe
# pero es pre-release (`next`/`beta`): no la uses en producción.
# Tags: https://hub.docker.com/r/n8nio/n8n/tags
N8N_IMAGE_TAG=2.36.7

# --- Clave de cifrado de credenciales ---------------------------------------
# Genérala UNA vez y guárdala en tu gestor de contraseñas (1Password/Bitwarden).
# Si la pierdes, TODAS las credenciales guardadas quedan indescifrables.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=n8n
# openssl rand -base64 24   (evita caracteres raros: $ y comillas rompen el .env)
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# --- Operación ---------------------------------------------------------------
TZ=America/Santiago
# Horas de retención del historial de ejecuciones (336 = 14 días).
EXECUTIONS_DATA_MAX_AGE=336
# API pública de n8n: "false" la deja habilitada (la necesitas para exportar/
# monitorear desde el harness), "true" la apaga. Si la dejas activa, la API key
# se crea en Settings → n8n API y vale tanto como el acceso al editor.
N8N_PUBLIC_API_DISABLED=false
